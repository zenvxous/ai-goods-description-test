APP_NAME=ai-goods-description
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# Any OpenAI-compatible API: OpenAI, OpenRouter, Ollama (http://localhost:11434/v1), vLLM...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Host port for docker compose
APP_PORT=8000
